<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latestMajor</LangVersion>
    <AssemblyName>FishermanMod</AssemblyName>
    <RootNamespace>FishermanMod</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;IDE0051;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Weaver\**" />
    <EmbeddedResource Remove="Weaver\**" />
    <None Remove="Weaver\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.ContentManagement" Version="1.1.0" />
    <PackageReference Include="R2API.DamageType" Version="1.1.7" />
    <PackageReference Include="R2API.Dot" Version="1.1.3" />
    <PackageReference Include="R2API.Language" Version="1.1.0" />
    <PackageReference Include="R2API.Networking" Version="1.0.4" />
    <PackageReference Include="R2API.Prefab" Version="1.1.1" />
    <PackageReference Include="R2API.RecalculateStats" Version="1.7.0" />
    <PackageReference Include="R2API.Sound" Version="1.0.3" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="RoR2BepInExPack" Version="1.49.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
  </ItemGroup>

  <!--
    UNet weaving: generates the code behind [Command], [ClientRpc], [TargetRpc] and [SyncVar].
    Without this step those attributes do nothing and Commands silently run on the client instead of the server.
    See NETWORKING.md in the repo root.
  -->
  <Target Name="WeaveNetworking" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <WeaverLibsDir>$(ProjectDir)$(IntermediateOutputPath)WeaverLibs</WeaverLibsDir>
    </PropertyGroup>
    <Copy SourceFiles="@(ReferencePath)" DestinationFolder="$(WeaverLibsDir)" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(ProjectDir)Weaver\Unity.UNetWeaver.exe&quot; &quot;$(WeaverLibsDir)\UnityEngine.CoreModule.dll&quot; &quot;$(WeaverLibsDir)\com.unity.multiplayer-hlapi.Runtime.dll&quot; &quot;$(TargetDir.TrimEnd('\'))&quot; &quot;$(TargetPath)&quot; &quot;$(WeaverLibsDir)&quot;" />
  </Target>

</Project>
